<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Spond as a data source for Kyuplan: groups, members and events are read from Spond.</Description>
    <RootNamespace>Kyuplan.Plugins.Spond</RootNamespace>
    <InternalsVisibleTo>Kyuplan.Plugins.Spond.Tests</InternalsVisibleTo>
    <!-- The folder of a plugin holds its own files only: the API provides the framework and the abstractions. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spond.API" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: Kyuplan.Plugins.Abstractions.dll is not copied; the API's copy is the one the plugin talks to. -->
    <ProjectReference Include="$(KyuplanRoot)src/Kyuplan.Plugins.Abstractions/Kyuplan.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(InternalsVisibleTo)" />
  </ItemGroup>

  <!-- What makes it a plugin: the manifest and the JSON of the settings form go into the package next to the assembly. -->
  <ItemGroup>
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ui/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
